[
{
"t0": 0.0,
"t1": 2.91,
"text": "ഈഫൽ ടവർ വിറ്റ് പൈസയുമായി മുങ്ങിയ ഒരു തട്ടിപ്പുകാരൻ!"
},
{
"t0": 3.25,
"t1": 5.59,
"text": "എന്നിട്ട് അതേ ടവർ വീണ്ടും വിൽക്കാൻ വന്നു!"
},
{
"t0": 6.15,
"t1": 7.61,
"text": "1925, പാരീസ്."
},
{
"t0": 7.95,
"t1": 11.1,
"text": "വിക്ടർ ലസ്റ്റിഗ് പത്രത്തിൽ ഒരു വാർത്ത വായിച്ചു:"
},
{
"t0": 11.64,
"t1": 13.94,
"text": "\"ഈഫൽ ടവർ നന്നാക്കാൻ ഭയങ്കര ചിലവ്!\""
},
{
"t0": 14.41,
"t1": 15.47,
"text": "ഉടനെ ഒരു ഐഡിയ!"
},
{
"t0": 15.9,
"t1": 17.58,
"text": "സർക്കാർ ഉദ്യോഗസ്ഥനായി വേഷം കെട്ടി."
},
{
"t0": 17.93,
"t1": 19.39,
"text": "വ്യാജ സർക്കാർ ലെറ്റർ ഉണ്ടാക്കി."
},
{
"t0": 19.88,
"t1": 23.55,
"text": "പാരീസിലെ വലിയ ഇരുമ്പ് കച്ചവടക്കാരെ ഒരു ആഡംബര ഹോട്ടലിലേക്ക് വിളിച്ചു."
},
{
"t0": 23.99,
"t1": 26.56,
"text": "\"ടവർ പൊളിച്ച് ഇരുമ്പ് വിൽക്കാൻ സർക്കാർ തീരുമാനിച്ചു."
},
{
"t0": 26.98,
"t1": 28.69,
"text": "പക്ഷേ ഇത് ടോപ്പ് സീക്രട്ട്!"
},
{
"t0": 28.69,
"t1": 29.76,
"text": "ആരോടും പറയരുത്!\""
},
{
"t0": 30.19,
"t1": 32.35,
"text": "ആന്ദ്രേ പ്വാസോൺ എന്ന കച്ചവടക്കാരൻ വീണു."
},
{
"t0": 32.88,
"t1": 34.66,
"text": "ഒരു സംശയം വന്നപ്പോൾ ലസ്റ്റിഗ് പറഞ്ഞു:"
},
{
"t0": 35.06,
"t1": 37.14,
"text": "\"എനിക്ക് ഒരു ചെറിയ കൈക്കൂലി കൂടി വേണം.\""
},
{
"t0": 37.53,
"t1": 39.58,
"text": "അതോടെ പ്വാസോണിന് ഉറപ്പായി:"
},
{
"t0": 39.89,
"t1": 42.05,
"text": "ഇവൻ ഒറിജിനൽ സർക്കാർ ഉദ്യോഗസ്ഥൻ തന്നെ!"
},
{
"t0": 42.46,
"t1": 46.55,
"text": "പൈസയും കൈക്കൂലിയും വാങ്ങി, ലസ്റ്റിഗ് അന്ന് തന്നെ ട്രെയിനിൽ കയറി രാജ്യം വിട്ടു!"
},
{
"t0": 47.03,
"t1": 50.11,
"text": "നാണക്കേട് കാരണം പ്വാസോൺ പോലീസിൽ പോലും പരാതി കൊടുത്തില്ല!"
},
{
"t0": 50.6,
"t1": 52.58,
"text": "ഒരു മാസം കഴിഞ്ഞ് ലസ്റ്റിഗ് തിരിച്ചു വന്നു…"
},
{
"t0": 52.98,
"t1": 54.47,
"text": "ഇതേ ടവർ വീണ്ടും വിൽക്കാൻ!"
},
{
"t0": 54.86,
"t1": 56.82,
"text": "ഇത്തവണ പക്ഷേ ഇര പോലീസിൽ പോയി."
},
{
"t0": 57.23,
"t1": 58.76,
"text": "ലസ്റ്റിഗ് അമേരിക്കയിലേക്ക് മുങ്ങി!"
},
{
"t0": 59.19,
"t1": 61.33,
"text": "അമേരിക്കയിൽ അയാൾ പറ്റിച്ചത് ആരെയാണെന്ന് അറിയാമോ?"
},
{
"t0": 61.69,
"t1": 63.45,
"text": "ഗുണ്ടാത്തലവൻ അൽ കപോണിനെ!"
},
{
"t0": 63.91,
"t1": 67.95,
"text": "50,000 ഡോളർ വാങ്ങി, രണ്ട് മാസം കഴിഞ്ഞ് അതേ പൈസ തിരിച്ചു കൊടുത്തു."
},
{
"t0": 68.33,
"t1": 69.65,
"text": "\"ബിസിനസ് പൊളിഞ്ഞു, സോറി.\""
},
{
"t0": 70.05,
"t1": 74.32,
"text": "സത്യസന്ധത കണ്ട് ഞെട്ടിയ കപോൺ സമ്മാനമായി 5,000 ഡോളർ കൊടുത്തു."
},
{
"t0": 74.32,
"t1": 75.68,
"text": "അതായിരുന്നു പ്ലാൻ!"
},
{
"t0": 76.02,
"t1": 79.8,
"text": "ഇതുപോലെ ഈഫൽ ടവർ വരെ വിൽക്കാൻ കഴിവുള്ള ആ ഒരു ഫ്രണ്ട് നിങ്ങൾക്കുമില്ലേ?"
},
{
"t0": 79.8,
"t1": 80.49,
"text": "ടാഗ് ചെയ്യൂ!"
}
]